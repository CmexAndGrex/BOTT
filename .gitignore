# Зависимости
node_modules/

# Папки сборки Next.js
.next/
out/
build/

# Служебная папка drizzle-kit (создаётся при check/push, не для коммита)
drizzle/
drizzle.docker.config.json

# Артефакты инкрементальной сборки TypeScript
*.tsbuildinfo

# Резервные копии базы (ОЧЕНЬ ВАЖНО! содержат персональные данные состава)
# Каталог создаётся приложением автоматически и монтируется томом в Docker.
backups/

# Секреты и переменные окружения (ОЧЕНЬ ВАЖНО!)
.env
.env.local
.env.development.local
.env.test.local
.env.production.local

# Паспорт сервисного аккаунта Google (ОЧЕНЬ ВАЖНО не публиковать!)
src/lib/google-service-account.json

# Логи и ошибки
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# Системные файлы ОС и настройки редактора
.DS_Store
.vscode/

# Дампы и выгрузки БД (ОЧЕНЬ ВАЖНО: содержат секреты и персональные данные состава).
# Правило закрывает и резервные копии приложения (atk_backup_*.sql), и любые
# ручные дампы вида backup-before-staging.sql, включая сжатые *.sql.gz.
*.sql
*.sql.gz
*.dump
backup-*.sql
backup-*.sql.gz
dbcheck*.txt

# Исключение из правила выше: миграции схемы — это исходный код (только DDL),
# они безопасны и применяются сервисом migrate. Без явного «!» они бы выпали
# из-под контроля версий вместе со всеми дампами.
!scripts/migrations/*.sql