#!/bin/sh
# Локальная проверка перед коммитом: не даём закоммитить секрет.
#
# Установка (один раз на клоне):
#   git config core.hooksPath .githooks
#
# Почему свой сканер, а не только gitleaks в CI: CI реагирует ПОСЛЕ push, а
# секрет в публичном репозитории к тому моменту уже утёк. Хук ловит его до
# создания коммита. Если нужно срочно обойти проверку (например, коммит
# тестовой фикстуры), используйте `git commit --no-verify` осознанно.

echo "[pre-commit] Проверка на утечки секретов…"
if ! node scripts/secret-scan.mjs; then
  echo ""
  echo "[pre-commit] Коммит отклонён: в файлах найден секрет."
  echo "[pre-commit] Удалите секрет и повторите. Обход (осознанно): git commit --no-verify"
  exit 1
fi
