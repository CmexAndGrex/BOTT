# Скопируйте этот файл в .env и заполните значения:
#   cp .env.example .env
# Пароль БД обязан быть длинным случайным. Токен бота можно оставить пустым —
# его удобнее ввести в самой панели (Настройки -> Discord).

# --- База данных и Docker ---
POSTGRES_PASSWORD=your_db_password_here
DATABASE_URL=postgresql://postgres:your_db_password_here@127.0.0.1:5432/app_db

# --- Безопасность панели ---
# ОБЯЗАТЕЛЬНО замените на свои случайные значения (рекомендуется 32+ символа).
# Если оставить значения из этого примера — панель в проде не запустится.
JWT_SECRET=replace_me_with_a_random_secret_of_at_least_32_characters
CRON_SECRET=replace_me_with_another_random_secret_32_characters_ok

# --- Первый администратор (создаётся скриптом scripts/seed-admin.mjs) ---
# В production ADMIN_PASSWORD обязателен, если администратора ещё нет.
# Существующий админ НЕ перезаписывается при обычном деплое.
# Пароль проверяется по политике: минимум 10 символов и минимум два вида
# символов (строчные/прописные/цифры/знаки), без распространённых паролей и дат.
# ADMIN_USERNAME=admin
# ADMIN_PASSWORD=your_secure_admin_password
# Сброс пароля существующего админа (только осознанно, затем убрать флаг!):
# ADMIN_PASSWORD_RESET=false

# --- Адрес панели для сборки расширения (необязательно) ---
# Если задан, именно он «зашивается» в архив расширения вместо адреса из
# заголовков запроса. Рекомендуется на проде за прокси.
# PANEL_URL=https://panel.вашдомен.ru

# --- Discord / rs-red (можно оставить пустым, заполняется из панели) ---
DISCORD_BOT_TOKEN=
RS_RED_COOKIE=

# --- Вход бойцов через Discord OAuth2 (основной способ) ---
# Отдельное приложение в Discord Developer Portal (или то же, но с OAuth2-разделом):
#   General Information → Client ID / Client Secret;
#   OAuth2 → Redirects → добавьте ровно этот адрес:
#     http://localhost:3000/api/auth/discord/callback   (для локальной разработки)
#     https://ваш-домен/api/auth/discord/callback        (для прода)
# Скоупы identify и guilds приложению выданы быть не обязаны — их запрашивает панель.
# Если не заданы — кнопка «Войти через Discord» отключается, вход по позывному и
# паролю продолжает работать (это и есть резервный канал).
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Необязательно. Адрес возврата, если внешний адрес панели отличается от того,
# что видит приложение за прокси. Должен совпадать с адресом из OAuth2 → Redirects.
# Пример: DISCORD_REDIRECT_URI=https://panel.вашдомен.ru/api/auth/discord/callback
# DISCORD_REDIRECT_URI=

# --- Сессии бойцов ---
# Отдельного секрета не требуется: cookie бойца (member_token) подписывается тем же
# JWT_SECRET, что и сессия панели, а срок жизни и отзыв управляются полем
# member_token_version в таблице division_members.
# Переменной NEXTAUTH_URL у проекта нет: приложение работает на собственной
# JWT-схеме (jose + httpOnly cookie), без NextAuth.

# --- Google-форма и запас (опционально, управляется из панели) ---
# Эти настройки хранятся в базе и редактируются в «Настройки → Google-форма и запас».
# Сюда можно ничего не писать — достаточно значений по умолчанию.

# --- Игровой сервер Arma 3: виджет «Кто на ВЧ» (необязательно) ---
# Адрес сервера подразделения для живого списка бойцов в кабинете. Запрос идёт
# по протоколу Valve A2S Query (UDP), поэтому нужен именно ПОРТ ЗАПРОСА, а не
# игровой: у Arma 3 это игровой порт + 1 (2302 → 2303).
#
# Если ARMA3_SERVER_HOST не задан, виджет честно показывает «сервер не настроен»
# и не делает ни одного UDP-запроса. Порт по умолчанию — 2303.
# Пример: ARMA3_SERVER_HOST=123.45.67.89
# ARMA3_SERVER_HOST=
# Игровой порт (необязательно): из него выводится порт запроса, если явный не задан
# ARMA3_SERVER_PORT=2302
# ARMA3_SERVER_QUERY_PORT=2303

# --- Часовой пояс контейнера ---
TZ=Europe/Moscow

# --- Обслуживание системы (необязательно) ---
# Каталог резервных копий. В Docker это том (backups), поэтому путь внутри
# контейнера — /app/backups. Каталог создаётся автоматически, коммитить его
# нельзя: дамп содержит персональные данные состава (см. .gitignore).
# BACKUP_DIR=/app/backups
# Сколько дней храним копии. Старше — удаляются ротацией сразу после успешного
# снятия новой копии.
# BACKUP_RETENTION_DAYS=7
# Сжатие дампов gzip. BACKUP_COMPRESS=false отключает (файл .sql вместо .sql.gz,
# удобно, если восстанавливать приходится вручную и без gunzip).
# BACKUP_COMPRESS=true

# --- Безопасность (необязательно) ---
# CSP с nonce включается автоматически. Если после обновления что-то
# перестало грузиться — временно отключите: DISABLE_CSP=true
# DISABLE_CSP=false
# HSTS ставится только когда панель работает по HTTPS (за прокси).
# Без домена/без TLS его нужно отключить: HSTS_DISABLED=true
# HSTS_DISABLED=false